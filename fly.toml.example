# Create the Fly app under the organization that owns this deployment.
app = "your-fly-app"
primary_region = "nrt"
kill_signal = "SIGTERM"
kill_timeout = "15s"

[build]
  dockerfile = "Dockerfile"
  build-target = "runtime"

[http_service]
  internal_port = 3001
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]
  [http_service.concurrency]
    type = "requests"
    soft_limit = 20
    hard_limit = 40
  [[http_service.checks]]
    grace_period = "20s"
    interval = "30s"
    method = "GET"
    path = "/api/health"
    timeout = "5s"

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory = "512mb"

# Credentials, CA and R2 keys are Fly Secrets: DB_USERNAME, DB_PASSWORD, DB_SSL_CA_BASE64,
# R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY.
[env]
  NODE_ENV = "production"
  API_HOST = "0.0.0.0"
  API_PORT = "3001"
  APP_ORIGIN = "https://guild.example.test"
  TRUSTED_PROXY_CIDRS = ""
  DB_HOST = "database.example.test"
  DB_PORT = "3306"
  DB_DATABASE = "example_database"
  DB_SSL_MODE = "verify_identity"
  DB_POOL_SIZE = "5"
  DB_QUEUE_LIMIT = "20"
  DB_CONNECT_TIMEOUT = "10000"
  R2_BUCKET = "example-bucket"
  R2_REGION = "auto"
