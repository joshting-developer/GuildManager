{
  "name": "guild-manager",
  "version": "2.2.3-hotfix.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "account:create": "node server/create-account.js",
    "seed:demo": "node tools/seed-demo-members.js",
    "dev": "vite --host 127.0.0.1",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tools/run-mysql-tests.js",
    "db:check": "node tools/check-mysql.js",
    "test:mysql": "node tools/run-mysql-tests.js",
    "db:migrate": "node tools/migrate-mysql.js",
    "db:status": "node tools/migrate-mysql.js --status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@mdi/js": "7.4.47",
    "echarts": "6.1.0",
    "express": "5.2.1",
    "mysql2": "3.24.6",
    "vue": "3.5.43",
    "vuetify": "4.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "7.3.6"
  }
}
