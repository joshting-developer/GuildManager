{
  "name": "guild-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "account:create": "node server/create-account.js",
    "seed:demo": "node tools/seed-demo-members.js",
    "dev": "vite --host 127.0.0.1",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "build:gas": "vite build --mode gas && node tools/package-gas.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "better-sqlite3": "12.11.1",
    "express": "5.2.1",
    "vue": "3.5.43",
    "vuetify": "4.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3"
  }
}
